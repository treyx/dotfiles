# =========== #
# Completions #
# =========== #

autoload -Uz compinit
# Only regenerate compinit cache once per day
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C  # skip security check, use cache
fi

# ====== #
# Prompt #
# ====== #

autoload -U promptinit; promptinit
prompt pure

# ====== #
# Config #
# ====== #

ZDOTDIR="${DOTFILES:-$HOME/projects/dotfiles}/zsh"

for file in "$ZDOTDIR"/{antigenrc,functions,aliases}.zsh; do
  [[ -f "$file" ]] && source "$file"
done

# Machine-specific overrides (gitignored)
[[ -f "$ZDOTDIR/local.zsh" ]] && source "$ZDOTDIR/local.zsh"
